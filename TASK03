#include <iostream>
using namespace std;

class Room {
private:
    float length;
    float width;

public:
    void setDimensions(float l, float w) {
        length = l;
        width = w;
    }

    float getArea() {
        return length * width;
    }

    float getPerimeter() {
        return 2 * (length + width);
    }

    void display(int roomNumber) {
        float a=getArea();
        float p=getPerimeter();
        cout << "Room "<< roomNumber<<endl;
        cout<<" area"<<a<<endl;
        cout<<"perimeter"<<p<<endl;

           
    }
};

int main() {
    int n;
    cout << "How many rooms do you want to calculate? ";
    cin >> n;

    Room rooms[50]; 
    float l, w;

    for (int i = 0; i < n; i++) {
        cout << "\nEnter length and width for Room " << i + 1 << ": ";
        cin >> l >> w;
        rooms[i].setDimensions(l, w);
    }

    cout << "\nRoom Measurements" << endl;
    for (int i = 0; i < n; i++) {
        rooms[i].display(i + 1);
    }

    return 0;
}
